    {
      "id": "b2c3d4e5-0003-4000-8000-000000000003",
      "name": "Has Callback Query?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 340],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-002",
              "leftValue": "={{ $json.hasCallbackQuery }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "b2c3d4e5-0004-4000-8000-000000000004",
      "name": "Parse Callback Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 240],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const callbackData = $input.item.json.callbackData || '';\nconst callbackQueryId = $input.item.json.callbackQueryId || '';\nconst originalBody = $input.item.json.originalBody || {};\n\n// Parse \"action:vacancyId\" format\nconst parts = callbackData.split(':');\nconst action = parts[0] || '';\nconst vacancyId = parts[1] || '';\n\nif (!action || !vacancyId) {\n  throw new Error(`Invalid callback data format: \"${callbackData}\". Expected \"action:vacancyId\"`);\n}\n\nreturn {\n  json: {\n    action,\n    vacancyId,\n    callbackQueryId,\n    originalBody,\n    rawCallbackData: callbackData\n  }\n};"
      }
    },
    {
      "id": "b2c3d4e5-0005-4000-8000-000000000005",
      "name": "Route by Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [1120, 240],
      "parameters": {
