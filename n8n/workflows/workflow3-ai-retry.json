{
  "name": "AI Limit Retry",
  "nodes": [
    {
      "id": "c3d4e5f6-0001-4000-8000-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 340],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 */2 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "c3d4e5f6-0002-4000-8000-000000000002",
      "name": "Fetch All Vacancies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 340],
      "parameters": {
        "method": "GET",
        "url": "http://localhost:3000/api/vacancies?limit=50",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.CRON_SECRET}}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "c3d4e5f6-0003-4000-8000-000000000003",
      "name": "Filter Pending Limit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 340],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Get all vacancies from the API response\nconst items = $input.first().json.data?.vacancies ?? [];\n\n// Filter only those with aiStatus === 'pending_limit'\nconst pending = items.filter(v => v.analysis?.aiStatus === 'pending_limit');\n\nif (pending.length === 0) {\n  // Return a sentinel so downstream IF can detect no work\n  return [{ json: { _noPendingItems: true, count: 0 } }];\n}\n\n// Return each vacancy as its own item for SplitInBatches\nreturn pending.map(v => ({ json: { ...v, _noPendingItems: false } }));"
      }
    },
    {
      "id": "c3d4e5f6-0004-4000-8000-000000000004",
      "name": "Has Pending Items?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 340],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-003",
              "leftValue": "={{ $json._noPendingItems }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "false"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "c3d4e5f6-0005-4000-8000-000000000005",
      "name": "Split in Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1120, 240],
      "parameters": {
        "batchSize": 3,
        "options": {
          "reset": false
        }
      }
    },
    {
      "id": "c3d4e5f6-0006-4000-8000-000000000006",
      "name": "Analyze Vacancy",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 240],
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/vacancies/analyze",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.CRON_SECRET}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"vacancyId\": \"{{ $json.id }}\" }",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      }
    },
    {
      "id": "c3d4e5f6-0007-4000-8000-000000000007",
      "name": "Wait Between Batches",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1560, 240],
      "parameters": {
        "resume": "timeInterval",
        "unit": "seconds",
        "value": 5
      },
      "webhookId": "wait-ai-retry-batch"
    },
    {
      "id": "c3d4e5f6-0008-4000-8000-000000000008",
      "name": "Send Telegram Done",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1120, 460],
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🔄 AI Retry complete!\n\nNo pending_limit vacancies found — all caught up.",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "telegram-cred-001",
          "name": "Telegram Bot API"
        }
      }
    },
    {
      "id": "c3d4e5f6-0009-4000-8000-000000000009",
      "name": "Retry Complete Notify",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1780, 240],
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "=🔄 AI Retry batch done!\n\n✅ Batch {{ $runIndex }} re-analyzed successfully.\n\nVacancy ID: {{ $('Split in Batches').item.json.id }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "telegram-cred-001",
          "name": "Telegram Bot API"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
