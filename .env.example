# ============================================================
# HH Job Copilot — Environment Variables Template
# Copy this file to .env.local and fill in your values
# ============================================================

# --- Database (PostgreSQL / NeonDB with connection pooling) ---
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# --- Application URL ---
APP_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Security & Secrets ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-32-byte-base64-auth-secret"
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="your-32-byte-encryption-secret-for-user-tokens"
# Secret token for authenticating automated cron jobs
CRON_SECRET="your-random-cron-secret-key"

# --- Telegram Bot (Optional for notifications & inline actions) ---
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_WEBHOOK_SECRET="your-telegram-webhook-secret-token"

# --- AI Provider API Keys (server-only; customers do not supply keys) ---
# Primary: Groq — https://console.groq.com
GROQ_API_KEY="gsk_..."
# Fallback 1: Google Gemini — https://aistudio.google.com
GEMINI_API_KEY="AIzaSy..."
# Fallback 2: OpenRouter — https://openrouter.ai
OPENROUTER_API_KEY="sk-or-v1-..."
# Fallback 3: OpenAI (optional)
OPENAI_API_KEY="sk-..."

# --- Default AI Provider Configuration ---
AI_PROVIDER_PRIMARY="groq"
AI_PROVIDER_FALLBACK_1="gemini"
AI_PROVIDER_FALLBACK_2="openrouter"

AI_MODEL_GROQ="qwen/qwen-2.5-72b-instruct"
AI_MODEL_GEMINI="gemini-1.5-flash"
AI_MODEL_OPENROUTER="meta-llama/llama-3.3-70b-instruct"

# --- HeadHunter (HH.ru) Public API Client & OAuth ---
# Get Client ID & Secret from: https://dev.hh.ru/admin
HH_CLIENT_ID="your_client_id_here"
HH_CLIENT_SECRET="your_client_secret_here"
# HH API requires a descriptive User-Agent with contact info
HH_USER_AGENT="HHJobCopilot/1.0 (contact@yourdomain.com)"

# --- Rate Limiting & Proxy (Optional) ---
# HTTP_PROXY="http://proxy-host:port"


# --- Paid Company Intel access (manual grants until billing is integrated) ---
# Comma-separated internal User.id values; empty means no paid access.
# Obtain IDs through trusted database administration, never from customer-submitted settings.
COMPANY_INTEL_USER_IDS=""

# Other server-side AI providers (optional)
DEEPSEEK_API_KEY=""
ANTHROPIC_API_KEY=""
# Optional model overrides: AI_MODEL_OPENAI, AI_MODEL_DEEPSEEK, AI_MODEL_ANTHROPIC.
# Dedicated project mailbox for OTP. Legacy EMAIL_USER/EMAIL_PASS are not used.
# Use an address authorized by this SMTP account, not an invented From address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=
